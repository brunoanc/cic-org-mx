{
	"name": "cic-org-mx",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"postbuild": "npx svelte-sitemap --domain https://cic.org.mx -t && sed -i 's#<loc>https://cic.org.mx/</loc>#<loc>https://cic.org.mx</loc>#g' build/sitemap.xml"
	},
	"devDependencies": {
		"@portabletext/svelte": "^3.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.55.0",
		"svelte-check": "^4.4.5",
		"svelte-sitemap": "^3.0.1",
		"sveltekit-html-minifier": "^1.0.4",
		"typescript": "^5.9.3",
		"vite": "^8.0.3"
	},
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.2.0",
		"@sanity/client": "^7.20.0",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"svelte-i18n": "^4.0.1",
		"svelte-typewriter": "^3.2.3"
	},
	"overrides": {
		"cookie": "^1.1.1",
		"esbuild": "^0.27.4"
	}
}
